{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/libs/angular-spec",
    "lib": ["ES2024", "DOM"],
    "types": ["vitest/globals"],
    "paths": {
      "@flagtide/core": ["../core/src/index.ts"],
      "@flagtide/angular": ["./src/index.ts"],
      "@flagtide/angular/overrides": ["./overrides/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["src/**/*.ts", "overrides/src/**/*.ts"]
}
